{
  "name": "paper_benchmark_manifest_dtu2",
  "defaults": {
    "output_dir": "runs/paper_v2/eval_dtu2",
    "gt_unit_to_mm": 1.0
  },
  "default_scene_tags": [
    "dtu2"
  ],
  "default_experiment_tags": [
    "main"
  ],
  "datasets": [
    {
      "name": "DTU",
      "scenes": [
        {
          "scene": "scan1",
          "scene_slug": "DTU_scan1",
          "tags": [
            "dtu2",
            "main"
          ],
          "prepared_scene_dir": "data/prepared/DTU/scan1",
          "scene_run_root_candidates": [
            "runs/DTU/scan1"
          ]
        },
        {
          "scene": "scan6",
          "scene_slug": "DTU_scan6",
          "tags": [
            "dtu2",
            "main"
          ],
          "prepared_scene_dir": "data/prepared/DTU/scan6",
          "scene_run_root_candidates": [
            "runs/DTU/scan6"
          ]
        }
      ]
    }
  ],
  "experiment_groups": [
    {
      "name": "gt_ligt",
      "tags": [
        "main"
      ],
      "rotation_source": "GT",
      "use_pa": false,
      "qtrack_mode": "weighted_sum",
      "enable_quality_weighting": true,
      "rraa_use_qpair_weight": false,
      "u_min": 0.001,
      "g_min": 0.001,
      "run_dir_candidates": [
        "runs/paper_v2/main/gt_ligt/{scene_slug}"
      ]
    },
    {
      "name": "gt_ligt_pa",
      "tags": [
        "main"
      ],
      "rotation_source": "GT",
      "use_pa": true,
      "qtrack_mode": "weighted_sum",
      "enable_quality_weighting": true,
      "rraa_use_qpair_weight": false,
      "u_min": 0.001,
      "g_min": 0.001,
      "run_dir_candidates": [
        "runs/paper_v2/main/gt_ligt_pa/{scene_slug}"
      ]
    },
    {
      "name": "rraa_ligt",
      "tags": [
        "main"
      ],
      "rotation_source": "RRAA",
      "use_pa": false,
      "qtrack_mode": "weighted_sum",
      "enable_quality_weighting": true,
      "rraa_use_qpair_weight": true,
      "u_min": 0.001,
      "g_min": 0.001,
      "run_dir_candidates": [
        "runs/paper_v2/main/rraa_ligt/{scene_slug}"
      ]
    },
    {
      "name": "rraa_ligt_pa",
      "tags": [
        "main"
      ],
      "rotation_source": "RRAA",
      "use_pa": true,
      "qtrack_mode": "weighted_sum",
      "enable_quality_weighting": true,
      "rraa_use_qpair_weight": true,
      "u_min": 0.001,
      "g_min": 0.001,
      "run_dir_candidates": [
        "runs/paper_v2/main/rraa_ligt_pa/{scene_slug}"
      ]
    }
  ]
}
