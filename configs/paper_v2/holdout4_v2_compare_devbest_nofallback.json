{
  "study_name": "holdout4_v2_compare_devbest_nofallback",
  "output_root": "runs/paper_v2/holdout4_v2_final_compare/devbest_nofallback",
  "n_trials": 1,
  "sampler": {
    "seed": 42,
    "multivariate": true,
    "group": true
  },
  "optuna_search_space": {
    "deltas_tracks": {
      "type": "categorical",
      "choices": ["1,2,3"]
    },
    "deltas_rraa": {
      "type": "categorical",
      "choices": ["1,2,3,5"]
    },
    "min_score": {
      "type": "categorical",
      "choices": [0.0]
    },
    "min_inliers_tracks": {
      "type": "categorical",
      "choices": [30]
    },
    "qpair_mode_tracks": {
      "type": "categorical",
      "choices": ["product"]
    },
    "ransac_px": {
      "type": "categorical",
      "choices": [1.0]
    },
    "min_inliers_map": {
      "type": "categorical",
      "choices": [
        "1:12,2:24,3:36,4:36,5:48,8:72,13:72,default:72"
      ]
    },
    "irls_iters": {
      "type": "categorical",
      "choices": [1]
    },
    "irls_huber_k": {
      "type": "categorical",
      "choices": [1.5]
    }
  },
  "base_validation_config": {
    "colmap_reference_json": "runs/paper_v2/final_benchmark_report/colmap_translation_references_12scenes.json",
    "quality_config": "configs/quality_config.no_rraa_weighting.json",
    "selection_criterion": "mean_plus_fail_penalty_plus_std",
    "scoring": {
      "primary_metric": "translation_vs_colmap_ratio",
      "lambda_fail": 1000.0,
      "lambda_skip": 100.0,
      "lambda_var": 1.0,
      "lambda_worst": 0.5,
      "lambda_rot": 0.5,
      "lambda_reject": 50.0
    },
    "default_candidate_stages": [
      {
        "name": "tracks",
        "cmd": [
          "{python}",
          "tools\\run_build_tracks_with_autok.py",
          "--prepared_scene_dir_autok",
          "{prepared_scene_dir}",
          "--dataset",
          "custom",
          "--image_glob",
          "{image_glob}",
          "--out_dir",
          "{candidate_root}\\tracks",
          "--device",
          "auto",
          "--max_kpts",
          "2048",
          "--filter_th",
          "0.1",
          "--mutual",
          "--min_score",
          "{min_score}",
          "--feature_cache_dir",
          "{scene_root}\\feature_cache_optuna",
          "--pair_match_cache_dir",
          "{scene_root}\\pair_match_cache_optuna",
          "--use_ransac",
          "--ransac_thresh",
          "1.0",
          "--min_inliers",
          "{min_inliers_tracks}",
          "--deltas",
          "{deltas_tracks}",
          "--qpair_mode",
          "{qpair_mode_tracks}",
          "--quality_config",
          "{quality_config}",
          "--auto_quality_refs",
          "--dump_quality_stats"
        ],
        "reuse_outputs": [
          "{candidate_root}\\tracks\\track_build_quality_stats.json"
        ]
      },
      {
        "name": "rraa_input",
        "cmd": [
          "{python}",
          "tools\\run_generate_rraa_input_with_autok.py",
          "--prepared_scene_dir_autok",
          "{prepared_scene_dir}",
          "--dataset",
          "custom",
          "--image_list",
          "{prepared_scene_dir}\\image_list.txt",
          "--out_npz",
          "{candidate_root}\\rraa_input\\rraa_input_{scene_id}.npz",
          "--device",
          "auto",
          "--deltas",
          "{deltas_rraa}",
          "--max_kpts",
          "2048",
          "--feature_cache_dir",
          "{scene_root}\\feature_cache_optuna",
          "--pair_match_cache_dir",
          "{scene_root}\\pair_match_cache_optuna",
          "--filter_th",
          "0.1",
          "--min_match_score",
          "{min_score}",
          "--ransac_px",
          "{ransac_px}",
          "--min_inliers_map",
          "{min_inliers_map}",
          "--add_reverse",
          "--use_h_fallback",
          "--save_meta",
          "--save_names",
          "--qpair_mode",
          "weighted_sum",
          "--quality_config",
          "{quality_config}",
          "--auto_quality_refs",
          "--dump_quality_stats"
        ],
        "reuse_outputs": [
          "{candidate_root}\\rraa_input\\rraa_input_{scene_id}.npz"
        ]
      },
      {
        "name": "rraa",
        "cmd": [
          "{python}",
          "tools\\RRAA_fast.py",
          "--npz",
          "{candidate_root}\\rraa_input\\rraa_input_{scene_id}.npz",
          "--out",
          "{candidate_root}\\rraa_output\\R_abs.npy",
          "--initial_l1_iters",
          "3",
          "--loss",
          "l1_2",
          "--a_deg",
          "5.0",
          "--irls_max_iter",
          "50",
          "--qpair_threshold",
          "0.0",
          "--quality_config",
          "{quality_config}",
          "--dump_quality_stats",
          "--diagnose_anchor_sensitivity",
          "--anchor_sensitivity_max_anchors",
          "2"
        ],
        "reuse_outputs": [
          "{candidate_root}\\rraa_output\\R_abs.npy",
          "{candidate_root}\\rraa_output\\R_abs_stats.json"
        ]
      },
      {
        "name": "pose_only",
        "cmd": [
          "{python}",
          "tools\\run_poseonly_with_flags.py",
          "--enable_quality_weighting_bool",
          "false",
          "--ligt_use_qtrack_weight_bool",
          "false",
          "--prepared_scene_dir_autok",
          "{prepared_scene_dir}",
          "--track_npz_dir",
          "{candidate_root}\\tracks",
          "--r_abs_npy",
          "{candidate_root}\\rraa_output\\R_abs.npy",
          "--dataset",
          "custom",
          "--gt_pose_txt",
          "{prepared_scene_dir}\\gt_poses_c2w.txt",
          "--out_dir",
          "{candidate_root}\\pose_only",
          "--min_track_len",
          "3",
          "--max_tracks",
          "20000",
          "--u_min",
          "0.0",
          "--g_min",
          "0.0",
          "--base_pair_candidates",
          "80",
          "--base_pair_full_search_len",
          "50",
          "--base_pair_min_gap",
          "0",
          "--base_pair_max_gap",
          "0",
          "--irls_iters",
          "{irls_iters}",
          "--irls_huber_k",
          "{irls_huber_k}",
          "--qtrack_mode",
          "log_additive",
          "--qtrack_threshold",
          "0.0",
          "--quality_config",
          "{quality_config}",
          "--auto_quality_refs",
          "--dump_quality_stats",
          "--dump_degeneracy_stats"
        ],
        "reuse_outputs": [
          "{candidate_root}\\pose_only\\poses_c2w_ligt.txt",
          "{candidate_root}\\pose_only\\quality_stats.json"
        ]
      },
      {
        "name": "eval_rotation",
        "cmd": [
          "{python}",
          "tools\\eval_rraa_rotation.py",
          "--est_npy",
          "{candidate_root}\\rraa_output\\R_abs.npy",
          "--gt_npy",
          "{prepared_scene_dir}\\R_abs_gt_w2c.npy",
          "--out_json",
          "{candidate_root}\\rraa_output\\eval_rotation.json"
        ],
        "reuse_outputs": [
          "{candidate_root}\\rraa_output\\eval_rotation.json"
        ]
      },
      {
        "name": "eval_translation",
        "cmd": [
          "{python}",
          "tools\\eval_poseonly_strecha_mm.py",
          "--est_poses",
          "{candidate_root}\\pose_only\\poses_c2w_ligt.txt",
          "--est_type",
          "c2w",
          "--gt_centers_npy",
          "{prepared_scene_dir}\\gt_centers.npy",
          "--gt_unit_to_mm",
          "{gt_unit_to_mm}",
          "--out_json",
          "{candidate_root}\\pose_only\\eval_translation.json"
        ],
        "reuse_outputs": [
          "{candidate_root}\\pose_only\\eval_translation.json"
        ]
      },
      {
        "name": "summary",
        "cmd": [
          "{python}",
          "tools\\experiment_summary.py",
          "--run_dir",
          "{candidate_root}",
          "--out_json",
          "{candidate_root}\\experiment_summary.json",
          "--track_stats_json",
          "{candidate_root}\\tracks\\track_build_quality_stats.json",
          "--rraa_stats_json",
          "{candidate_root}\\rraa_output\\R_abs_stats.json",
          "--ligt_quality_json",
          "{candidate_root}\\pose_only\\quality_stats.json",
          "--ligt_degeneracy_json",
          "{candidate_root}\\pose_only\\ligt_degeneracy_stats.json",
          "--qtrack_npz",
          "{candidate_root}\\pose_only\\track_quality_scores.npz",
          "--rraa_eval_json",
          "{candidate_root}\\rraa_output\\eval_rotation.json",
          "--pose_eval_json",
          "{candidate_root}\\pose_only\\eval_translation.json"
        ],
        "reuse_outputs": [
          "{candidate_root}\\experiment_summary.json"
        ]
      }
    ],
    "scenes": "configs/paper_v2/scenes_strecha2_dtu2_holdout4_v2.json"
  }
}
