{
  "output_root": "runs/paper_v2/ablation_v1/stable_protocol_with_pa",
  "selection_criterion": "mean_plus_fail_penalty_plus_std",
  "scoring": {
    "primary_metric": "translation_vs_colmap_ratio",
    "lambda_fail": 1000.0,
    "lambda_skip": 100.0,
    "lambda_var": 1.0,
    "lambda_worst": 1.0,
    "lambda_reject": 50.0
  },
  "search_space": {},
  "colmap_reference_json": "runs/paper_v2/final_benchmark_report/colmap_translation_references_12scenes.json",
  "quality_config": "configs/quality_config.template.json",
  "candidate_stage_fallbacks": [
    {
      "tag": "rraa_retry_with_gap8",
      "trigger_stage": "rraa",
      "rerun_from_stage": "rraa_input",
      "override_params": {
        "deltas_rraa": "1,2,3,5,8"
      }
    }
  ],
  "default_candidate_stages": [
    {
      "name": "tracks",
      "cmd": [
        "{python}",
        "tools\\run_build_tracks_with_autok.py",
        "--prepared_scene_dir_autok",
        "{prepared_scene_dir}",
        "--dataset",
        "custom",
        "--image_glob",
        "{image_glob}",
        "--out_dir",
        "{candidate_root}\\tracks",
        "--device",
        "auto",
        "--max_kpts",
        "2048",
        "--filter_th",
        "0.1",
        "--mutual",
        "--min_score",
        "0.0",
        "--feature_cache_dir",
        "{scene_root}\\feature_cache_optuna",
        "--pair_match_cache_dir",
        "{scene_root}\\pair_match_cache_optuna",
        "--use_ransac",
        "--ransac_thresh",
        "1.0",
        "--min_inliers",
        "30",
        "--deltas",
        "1,2,3",
        "--qpair_mode",
        "product",
        "--quality_config",
        "{quality_config}",
        "--auto_quality_refs",
        "--dump_quality_stats"
      ],
      "reuse_outputs": [
        "{candidate_root}\\tracks\\track_build_quality_stats.json"
      ]
    },
    {
      "name": "rraa_input",
      "cmd": [
        "{python}",
        "tools\\run_generate_rraa_input_with_autok.py",
        "--prepared_scene_dir_autok",
        "{prepared_scene_dir}",
        "--dataset",
        "custom",
        "--image_list",
        "{prepared_scene_dir}\\image_list.txt",
        "--out_npz",
        "{candidate_root}\\rraa_input\\rraa_input_{scene_id}.npz",
        "--device",
        "auto",
        "--deltas",
        "{deltas_rraa}",
        "--max_kpts",
        "2048",
        "--feature_cache_dir",
        "{scene_root}\\feature_cache_optuna",
        "--pair_match_cache_dir",
        "{scene_root}\\pair_match_cache_optuna",
        "--filter_th",
        "0.1",
        "--min_match_score",
        "0.0",
        "--ransac_px",
        "1.0",
        "--min_inliers_map",
        "1:12,2:24,3:36,4:36,5:48,8:72,13:72,default:72",
        "--add_reverse",
        "--use_h_fallback",
        "--save_meta",
        "--save_names",
        "--qpair_mode",
        "weighted_sum",
        "--quality_config",
        "{quality_config}",
        "--auto_quality_refs",
        "--dump_quality_stats"
      ],
      "reuse_outputs": [
        "{candidate_root}\\rraa_input\\rraa_input_{scene_id}.npz"
      ]
    },
    {
      "name": "rraa",
      "cmd": [
        "{python}",
        "tools\\RRAA_fast.py",
        "--npz",
        "{candidate_root}\\rraa_input\\rraa_input_{scene_id}.npz",
        "--out",
        "{candidate_root}\\rraa_output\\R_abs.npy",
        "--initial_l1_iters",
        "3",
        "--loss",
        "l1_2",
        "--a_deg",
        "5.0",
        "--irls_max_iter",
        "50",
        "--qpair_threshold",
        "0.0",
        "--quality_config",
        "{quality_config}",
        "--dump_quality_stats",
        "--diagnose_anchor_sensitivity",
        "--anchor_sensitivity_max_anchors",
        "2",
        "--enable_quality_weighting",
        "--rraa_use_qpair_weight"
      ],
      "reuse_outputs": [
        "{candidate_root}\\rraa_output\\R_abs.npy",
        "{candidate_root}\\rraa_output\\R_abs_stats.json"
      ]
    },
    {
      "name": "pose_only",
      "cmd": [
        "{python}",
        "tools\\run_poseonly_with_flags.py",
        "--enable_quality_weighting_bool",
        "true",
        "--ligt_use_qtrack_weight_bool",
        "true",
        "--prepared_scene_dir_autok",
        "{prepared_scene_dir}",
        "--track_npz_dir",
        "{candidate_root}\\tracks",
        "--r_abs_npy",
        "{candidate_root}\\rraa_output\\R_abs.npy",
        "--dataset",
        "custom",
        "--gt_pose_txt",
        "{prepared_scene_dir}\\gt_poses_c2w.txt",
        "--out_dir",
        "{candidate_root}\\pose_only",
        "--min_track_len",
        "3",
        "--max_tracks",
        "20000",
        "--u_min",
        "0.01",
        "--g_min",
        "0.001",
        "--base_pair_candidates",
        "80",
        "--base_pair_full_search_len",
        "50",
        "--irls_iters",
        "1",
        "--qtrack_mode",
        "log_additive",
        "--qtrack_threshold",
        "0.2",
        "--quality_config",
        "{quality_config}",
        "--auto_quality_refs",
        "--dump_quality_stats",
        "--dump_degeneracy_stats",
        "--run_pa",
        "--pa_loss",
        "soft_l1",
        "--pa_max_init_rmse",
        "0.05",
        "--pa_use_qtrack"
      ],
      "reuse_outputs": [
        "{candidate_root}\\pose_only\\poses_c2w.txt",
        "{candidate_root}\\pose_only\\quality_stats.json"
      ]
    },
    {
      "name": "eval_rotation",
      "cmd": [
        "{python}",
        "tools\\eval_rraa_rotation.py",
        "--est_npy",
        "{candidate_root}\\rraa_output\\R_abs.npy",
        "--gt_npy",
        "{prepared_scene_dir}\\R_abs_gt_w2c.npy",
        "--out_json",
        "{candidate_root}\\rraa_output\\eval_rotation.json"
      ],
      "reuse_outputs": [
        "{candidate_root}\\rraa_output\\eval_rotation.json"
      ]
    },
    {
      "name": "eval_translation",
      "cmd": [
        "{python}",
        "tools\\eval_poseonly_strecha_mm.py",
        "--est_poses",
        "{candidate_root}\\pose_only\\poses_c2w.txt",
        "--est_type",
        "c2w",
        "--gt_centers_npy",
        "{prepared_scene_dir}\\gt_centers.npy",
        "--gt_unit_to_mm",
        "{gt_unit_to_mm}",
        "--out_json",
        "{candidate_root}\\pose_only\\eval_translation.json"
      ],
      "reuse_outputs": [
        "{candidate_root}\\pose_only\\eval_translation.json"
      ]
    },
    {
      "name": "summary",
      "cmd": [
        "{python}",
        "tools\\experiment_summary.py",
        "--run_dir",
        "{candidate_root}",
        "--out_json",
        "{candidate_root}\\experiment_summary.json",
        "--track_stats_json",
        "{candidate_root}\\tracks\\track_build_quality_stats.json",
        "--rraa_stats_json",
        "{candidate_root}\\rraa_output\\R_abs_stats.json",
        "--ligt_quality_json",
        "{candidate_root}\\pose_only\\quality_stats.json",
        "--ligt_degeneracy_json",
        "{candidate_root}\\pose_only\\ligt_degeneracy_stats.json",
        "--pa_degeneracy_json",
        "{candidate_root}\\pose_only\\pa_degeneracy_stats.json",
        "--qtrack_npz",
        "{candidate_root}\\pose_only\\track_quality_scores.npz",
        "--rraa_eval_json",
        "{candidate_root}\\rraa_output\\eval_rotation.json",
        "--pose_eval_json",
        "{candidate_root}\\pose_only\\eval_translation.json"
      ],
      "reuse_outputs": [
        "{candidate_root}\\experiment_summary.json"
      ]
    }
  ],
  "scenes": [
    {
      "name": "strecha_fountain_P11",
      "dataset": "strecha",
      "scene_id": "fountain-P11",
      "prepared_scene_dir": "data/prepared/strecha/fountain-P11",
      "scene_root": "runs/strecha/fountain-P11",
      "image_glob": "data/raw/strecha/fountain-P11/images/*.jpg",
      "gt_unit_to_mm": 1000,
      "deltas_rraa": "1,2,3,5"
    },
    {
