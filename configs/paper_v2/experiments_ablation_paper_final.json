{
  "name": "paper_final_ablation_matrix",
  "base_template_config": "configs/paper_v2/compare12_split_v2_final_nofallback_plus_gap8.json",
  "output_root_base": "runs/paper_v2/ablation_paper_final",
  "scenes": "configs/paper_v2/scenes_strecha6_dtu6_12scenes.json",
  "maps": {
    "uniform": "1:30,2:30,3:30,4:30,5:30,8:30,13:30,default:30",
    "strict": "1:12,2:24,3:36,4:36,5:48,8:72,13:72,default:72",
    "strict_nearby": "1:12,2:24,3:32,4:32,5:44,8:68,13:68,default:68"
  },
  "defaults": {
    "deltas_tracks": "1,2,3",
    "deltas_rraa": "1,2,3,5",
    "min_score": 0.0,
    "min_inliers_tracks": 30,
    "qpair_mode_tracks": "weighted_sum",
    "ransac_px": 1.0,
    "min_inliers_map": "1:30,2:30,3:30,4:30,5:30,8:30,13:30,default:30",
    "irls_iters": 0,
    "irls_huber_k": 1.5
  },
  "runs": [
    {
      "id": "A0_chain_lower_bound",
      "table": "A",
      "description": "Minimal-Paper-Base: chain tracks + chain RRAA graph",
      "output_subdir": "A/A0_chain_lower_bound",
      "params": {
        "deltas_tracks": "1",
        "deltas_rraa": "1"
      }
    },
    {
      "id": "A1_tracks_multigap_only",
      "table": "A",
      "description": "Only enlarge tracks graph span",
      "output_subdir": "A/A1_tracks_multigap_only",
      "params": {
        "deltas_tracks": "1,2,3",
        "deltas_rraa": "1"
      }
    },
    {
      "id": "A2_short_rotation_graph",
      "table": "A",
      "description": "Short-range RRAA graph",
      "output_subdir": "A/A2_short_rotation_graph",
      "params": {
        "deltas_tracks": "1,2,3",
        "deltas_rraa": "1,2,3"
      }
    },
    {
      "id": "A3_paper_base",
      "table": "A",
      "description": "Paper-Base / short-mid rotation graph",
      "output_subdir": "A/A3_paper_base",
      "params": {
        "deltas_tracks": "1,2,3",
        "deltas_rraa": "1,2,3,5"
      }
    },
    {
      "id": "A4_plus_gap8_uniform",
      "table": "A",
      "description": "Add long-gap rotation graph while keeping uniform filtering and no IRLS",
      "output_subdir": "A/A4_plus_gap8_uniform",
      "params": {
        "deltas_tracks": "1,2,3",
        "deltas_rraa": "1,2,3,5,8"
      }
    },
    {
      "id": "A5_plus_gap13_optional",
      "table": "A",
      "description": "Optional over-long graph test",
      "output_subdir": "A/A5_plus_gap13_optional",
      "optional": true,
      "params": {
        "deltas_tracks": "1,2,3",
        "deltas_rraa": "1,2,3,5,8,13"
      }
    },
    {
      "id": "F1_score_filter_only",
      "table": "F",
      "description": "Enable score threshold after fixing long-gap graph",
      "output_subdir": "F/F1_score_filter_only",
      "params": {
        "deltas_tracks": "1,2,3",
        "deltas_rraa": "1,2,3,5,8",
        "min_score": 0.05,
        "min_inliers_map": "1:30,2:30,3:30,4:30,5:30,8:30,13:30,default:30"
      }
    },
    {
      "id": "F2_gap_adaptive_strict",
      "table": "F",
      "description": "Enable strict gap-adaptive inlier map",
      "output_subdir": "F/F2_gap_adaptive_strict",
      "params": {
        "deltas_tracks": "1,2,3",
        "deltas_rraa": "1,2,3,5,8",
        "min_score": 0.05,
        "min_inliers_map": "1:12,2:24,3:36,4:36,5:48,8:72,13:72,default:72"
      }
    },
    {
      "id": "F3_gap_adaptive_strict_nearby_optional",
      "table": "F",
      "description": "Optional neighboring strict map",
      "output_subdir": "F/F3_gap_adaptive_strict_nearby_optional",
      "optional": true,
      "params": {
        "deltas_tracks": "1,2,3",
        "deltas_rraa": "1,2,3,5,8",
        "min_score": 0.05,
        "min_inliers_map": "1:12,2:24,3:32,4:32,5:44,8:68,13:68,default:68"
      }
    },
    {
      "id": "I1_irls1_huber15",
      "table": "I",
      "description": "Final no-quality backbone with one IRLS iteration",
      "output_subdir": "I/I1_irls1_huber15",
      "params": {
        "deltas_tracks": "1,2,3",
        "deltas_rraa": "1,2,3,5,8",
        "min_score": 0.05,
        "min_inliers_map": "1:12,2:24,3:36,4:36,5:48,8:72,13:72,default:72",
        "irls_iters": 1,
        "irls_huber_k": 1.5
      }
    },
    {
      "id": "A4_plus_gap8_uniform_irls1",
      "table": "I",
      "description": "Clean IRLS ablation on top of A4 uniform long-gap graph",
      "output_subdir": "I/A4_plus_gap8_uniform_irls1",
      "params": {
        "deltas_tracks": "1,2,3",
        "deltas_rraa": "1,2,3,5,8",
        "min_score": 0.0,
        "min_inliers_map": "1:30,2:30,3:30,4:30,5:30,8:30,13:30,default:30",
        "irls_iters": 1,
        "irls_huber_k": 1.5
      }
    },
    {
      "id": "A4_plus_gap8_uniform_irls2",
      "table": "I",
      "description": "Clean two-iteration IRLS ablation on top of A4 uniform long-gap graph",
      "output_subdir": "I/A4_plus_gap8_uniform_irls2",
      "params": {
        "deltas_tracks": "1,2,3",
        "deltas_rraa": "1,2,3,5,8",
        "min_score": 0.0,
        "min_inliers_map": "1:30,2:30,3:30,4:30,5:30,8:30,13:30,default:30",
        "irls_iters": 2,
        "irls_huber_k": 1.5
      }
    },
    {
      "id": "A4_plus_gap8_uniform_irls1_huber20",
      "table": "I",
      "description": "Clean IRLS Huber-k sensitivity on top of A4 uniform long-gap graph",
      "output_subdir": "I/A4_plus_gap8_uniform_irls1_huber20",
      "optional": true,
      "params": {
        "deltas_tracks": "1,2,3",
        "deltas_rraa": "1,2,3,5,8",
        "min_score": 0.0,
        "min_inliers_map": "1:30,2:30,3:30,4:30,5:30,8:30,13:30,default:30",
        "irls_iters": 1,
        "irls_huber_k": 2.0
      }
    },
    {
      "id": "I2_irls2_huber15",
      "table": "I",
      "description": "Two IRLS iterations",
      "output_subdir": "I/I2_irls2_huber15",
      "params": {
        "deltas_tracks": "1,2,3",
        "deltas_rraa": "1,2,3,5,8",
        "min_score": 0.05,
        "min_inliers_map": "1:12,2:24,3:36,4:36,5:48,8:72,13:72,default:72",
        "irls_iters": 2,
        "irls_huber_k": 1.5
      }
    },
    {
      "id": "I3_irls1_huber20_optional",
      "table": "I",
      "description": "Optional Huber sensitivity",
      "output_subdir": "I/I3_irls1_huber20_optional",
      "optional": true,
      "params": {
        "deltas_tracks": "1,2,3",
        "deltas_rraa": "1,2,3,5,8",
        "min_score": 0.05,
        "min_inliers_map": "1:12,2:24,3:36,4:36,5:48,8:72,13:72,default:72",
        "irls_iters": 1,
        "irls_huber_k": 2.0
      }
    }
  ],
  "logical_tables": {
    "M_main_cumulative": [
      {
        "label": "M0",
        "title": "Paper-Base",
        "source_run_id": "A3_paper_base"
      },
      {
        "label": "M1",
        "title": "+ long-gap graph",
        "source_run_id": "A4_plus_gap8_uniform"
      },
      {
        "label": "M2",
        "title": "+ structured frontend filtering",
        "source_run_id": "F2_gap_adaptive_strict"
      },
      {
        "label": "M3",
        "title": "+ LiGT IRLS",
        "source_run_id": "I1_irls1_huber15"
      },
      {
        "label": "M4",
        "title": "+ dev/holdout frozen final protocol",
        "source_run_id": "I1_irls1_huber15",
        "note": "Metrics reuse the same final plus-gap8 configuration; text should cite split_v2 dev/holdout freezing process."
      }
    ],
    "A_graph_protocol": [
      {
        "label": "A0",
        "source_run_id": "A0_chain_lower_bound"
      },
      {
        "label": "A1",
        "source_run_id": "A1_tracks_multigap_only"
      },
      {
        "label": "A2",
        "source_run_id": "A2_short_rotation_graph"
      },
      {
        "label": "A3",
        "source_run_id": "A3_paper_base"
      },
      {
        "label": "A4",
        "source_run_id": "A4_plus_gap8_uniform"
      },
      {
        "label": "A5",
        "source_run_id": "A5_plus_gap13_optional"
      }
    ],
    "F_frontend_filtering": [
      {
        "label": "F0",
        "source_run_id": "A4_plus_gap8_uniform"
      },
      {
        "label": "F1",
        "source_run_id": "F1_score_filter_only"
      },
      {
        "label": "F2",
        "source_run_id": "F2_gap_adaptive_strict"
      },
      {
        "label": "F3",
        "source_run_id": "F3_gap_adaptive_strict_nearby_optional"
      }
    ],
    "I_irls": [
      {
        "label": "I0",
        "source_run_id": "F2_gap_adaptive_strict"
      },
      {
        "label": "I1",
        "source_run_id": "I1_irls1_huber15"
      },
      {
        "label": "I2",
        "source_run_id": "I2_irls2_huber15"
      },
      {
        "label": "I3",
        "source_run_id": "I3_irls1_huber20_optional"
      }
    ]
  }
}
