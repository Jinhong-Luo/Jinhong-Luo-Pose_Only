{
  "study_name": "optuna_rraa_ligt_minimal_12scenes",
  "output_root": "runs/paper_v2/optuna_rraa_ligt_minimal_12scenes",
  "n_trials": 20,
  "sampler": {
    "seed": 42,
    "multivariate": true,
    "group": true
  },
  "optuna_search_space": {
    "u_min": {
      "type": "categorical",
      "choices": [0.0001, 0.001, 0.01]
    },
    "g_min": {
      "type": "categorical",
      "choices": [0.0001, 0.001, 0.01]
    },
    "min_track_len": {
      "type": "categorical",
      "choices": [3, 4, 5]
    },
    "qtrack_mode": {
      "type": "categorical",
      "choices": ["weighted_sum", "log_additive"]
    },
    "qtrack_threshold": {
      "type": "categorical",
      "choices": [0.0, 0.1, 0.2]
    },
    "enable_quality_weighting": {
      "type": "categorical",
      "choices": [true, false]
    },
    "ligt_use_qtrack_weight": {
      "type": "categorical",
      "choices": [true, false]
    },
    "irls_iters": {
      "type": "categorical",
      "choices": [1, 2, 3]
    }
  },
  "base_validation_config": {
    "quality_config": "configs/quality_config.template.json",
    "selection_criterion": "mean_plus_fail_penalty_plus_std",
    "scoring": {
      "primary_metric": "auto_translation",
      "lambda_fail": 1000.0,
      "lambda_skip": 100.0,
      "lambda_var": 1.0,
      "lambda_worst": 0.25,
      "lambda_reject": 50.0
    },
    "default_candidate_stages": [
      {
        "name": "rraa",
        "cmd": [
          "{python}",
          "tools\\RRAA_fast.py",
          "--npz",
          "{scene_root}\\rraa_input\\rraa_input_{scene_id}.npz",
          "--out",
          "{candidate_root}\\rraa_output\\R_abs.npy",
          "--initial_l1_iters",
          "3",
          "--loss",
          "l1_2",
          "--a_deg",
          "5.0",
          "--irls_max_iter",
          "50",
          "--qpair_threshold",
          "0.0",
          "--quality_config",
          "{quality_config}",
          "--dump_quality_stats",
          "--diagnose_anchor_sensitivity",
          "--anchor_sensitivity_max_anchors",
          "2",
          "--enable_quality_weighting",
          "--rraa_use_qpair_weight"
        ],
        "reuse_outputs": [
          "{candidate_root}\\rraa_output\\R_abs.npy",
          "{candidate_root}\\rraa_output\\R_abs_stats.json"
        ]
      },
      {
        "name": "pose_only",
        "cmd": [
          "{python}",
          "tools\\run_poseonly_with_flags.py",
          "--enable_quality_weighting_bool",
          "{enable_quality_weighting}",
          "--ligt_use_qtrack_weight_bool",
          "{ligt_use_qtrack_weight}",
          "--prepared_scene_dir_autok",
          "{prepared_scene_dir}",
          "--track_npz_dir",
          "{scene_root}\\tracks",
          "--r_abs_npy",
          "{candidate_root}\\rraa_output\\R_abs.npy",
          "--dataset",
          "custom",
          "--gt_pose_txt",
          "{prepared_scene_dir}\\gt_poses_c2w.txt",
          "--out_dir",
          "{candidate_root}\\pose_only",
          "--min_track_len",
          "{min_track_len}",
          "--max_tracks",
          "20000",
          "--u_min",
          "{u_min}",
          "--g_min",
          "{g_min}",
          "--base_pair_candidates",
          "80",
          "--base_pair_full_search_len",
          "50",
          "--irls_iters",
          "{irls_iters}",
          "--qtrack_mode",
          "{qtrack_mode}",
          "--qtrack_threshold",
          "{qtrack_threshold}",
          "--quality_config",
          "{quality_config}",
          "--auto_quality_refs",
          "--dump_quality_stats",
          "--dump_degeneracy_stats"
        ],
        "reuse_outputs": [
          "{candidate_root}\\pose_only\\poses_c2w_ligt.txt",
          "{candidate_root}\\pose_only\\quality_stats.json"
        ]
      },
      {
        "name": "eval_rotation",
        "cmd": [
          "{python}",
          "tools\\eval_rraa_rotation.py",
          "--est_npy",
          "{candidate_root}\\rraa_output\\R_abs.npy",
          "--gt_npy",
          "{prepared_scene_dir}\\R_abs_gt_w2c.npy",
          "--out_json",
          "{candidate_root}\\rraa_output\\eval_rotation.json"
        ],
        "reuse_outputs": [
          "{candidate_root}\\rraa_output\\eval_rotation.json"
        ]
      },
      {
        "name": "eval_translation",
        "cmd": [
          "{python}",
          "tools\\eval_poseonly_strecha_mm.py",
          "--est_poses",
          "{candidate_root}\\pose_only\\poses_c2w_ligt.txt",
          "--est_type",
          "c2w",
          "--gt_centers_npy",
          "{prepared_scene_dir}\\gt_centers.npy",
          "--gt_unit_to_mm",
          "{gt_unit_to_mm}",
          "--out_json",
          "{candidate_root}\\pose_only\\eval_translation.json"
        ],
        "reuse_outputs": [
          "{candidate_root}\\pose_only\\eval_translation.json"
        ]
      },
      {
        "name": "summary",
        "cmd": [
          "{python}",
          "tools\\experiment_summary.py",
          "--run_dir",
          "{candidate_root}",
          "--out_json",
          "{candidate_root}\\experiment_summary.json",
          "--track_stats_json",
          "{scene_root}\\tracks\\track_build_quality_stats.json",
          "--rraa_stats_json",
          "{candidate_root}\\rraa_output\\R_abs_stats.json",
          "--ligt_quality_json",
          "{candidate_root}\\pose_only\\quality_stats.json",
          "--ligt_degeneracy_json",
          "{candidate_root}\\pose_only\\ligt_degeneracy_stats.json",
          "--qtrack_npz",
          "{candidate_root}\\pose_only\\track_quality_scores.npz",
          "--rraa_eval_json",
          "{candidate_root}\\rraa_output\\eval_rotation.json",
          "--pose_eval_json",
          "{candidate_root}\\pose_only\\eval_translation.json"
        ],
        "reuse_outputs": [
          "{candidate_root}\\experiment_summary.json"
        ]
      }
    ],
    "scenes": [
      {
        "name": "strecha_fountain_P11",
        "group": "strecha",
        "scene_id": "fountain-P11",
        "scene_root": "runs/strecha/fountain-P11",
        "prepared_scene_dir": "data/prepared/strecha/fountain-P11",
        "gt_unit_to_mm": 1000,
        "metrics": {
          "rotation_json": "{candidate_root}\\rraa_output\\eval_rotation.json",
          "translation_json": "{candidate_root}\\pose_only\\eval_translation.json",
          "summary_json": "{candidate_root}\\experiment_summary.json",
          "ligt_json": "{candidate_root}\\pose_only\\quality_stats.json",
          "rraa_stats_json": "{candidate_root}\\rraa_output\\R_abs_stats.json"
        }
      },
