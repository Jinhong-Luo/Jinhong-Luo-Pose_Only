{
  "name": "frontend_dtu2_original_tracks",
  "quality_config": "configs/quality_config.template.json",
  "output_root": "runs/paper_v2/frontend_dtu2_original_tracks",
  "scenes": [
    {
      "name": "DTU_scan1",
      "scene_id": "scan1",
      "scene_root": "runs/DTU/scan1",
      "prepared_scene_dir": "data/prepared/DTU/scan1",
      "frontend_stages": [
        {
          "name": "tracks",
          "cmd": [
            "{python}",
            "tools/build_lightglue_tracks_npz.py",
            "--dataset", "custom",
            "--Ks_npy", "{prepared_scene_dir}/Ks.npy",
            "--image_K_idx_npy", "{prepared_scene_dir}/image_K_idx.npy",
            "--image_glob", "data/raw/DTU/SampleSet/MVS Data/Rectified/{scene_id}/rect_*_3_r5000.png",
            "--out_dir", "{scene_root}/tracks",
            "--device", "auto",
            "--max_kpts", "2048",
            "--filter_th", "0.1",
            "--mutual",
            "--min_score", "0.0",
            "--use_ransac",
            "--ransac_thresh", "1.0",
            "--min_inliers", "50",
            "--deltas", "1,2,3,5",
            "--quality_config", "{quality_config}",
            "--auto_quality_refs",
            "--dump_quality_stats"
          ],
          "reuse_outputs": [
            "{scene_root}/tracks/track_build_quality_stats.json"
          ]
        },
        {
          "name": "rraa_input",
          "cmd": [
            "{python}",
            "tools/generate_rraa_input.py",
            "--dataset", "custom",
            "--Ks_npy", "{prepared_scene_dir}/Ks.npy",
            "--image_K_idx_npy", "{prepared_scene_dir}/image_K_idx.npy",
            "--image_list", "{prepared_scene_dir}/image_list.txt",
            "--out_npz", "{scene_root}/rraa_input/rraa_input_{scene_id}.npz",
            "--device", "auto",
            "--deltas", "1,2,3,5",
            "--max_kpts", "2048",
            "--filter_th", "0.1",
            "--ransac_px", "2.0",
            "--add_reverse",
            "--use_h_fallback",
            "--save_meta",
            "--save_names",
            "--quality_config", "{quality_config}",
            "--auto_quality_refs",
            "--dump_quality_stats"
          ],
          "reuse_outputs": [
            "{scene_root}/rraa_input/rraa_input_{scene_id}.npz"
          ]
        }
      ]
    },
    {
      "name": "DTU_scan6",
      "scene_id": "scan6",
      "scene_root": "runs/DTU/scan6",
      "prepared_scene_dir": "data/prepared/DTU/scan6",
      "frontend_stages": [
        {
          "name": "tracks",
          "cmd": [
            "{python}",
            "tools/build_lightglue_tracks_npz.py",
            "--dataset", "custom",
            "--Ks_npy", "{prepared_scene_dir}/Ks.npy",
            "--image_K_idx_npy", "{prepared_scene_dir}/image_K_idx.npy",
            "--image_glob", "data/raw/DTU/SampleSet/MVS Data/Rectified/{scene_id}/rect_*_3_r5000.png",
            "--out_dir", "{scene_root}/tracks",
            "--device", "auto",
            "--max_kpts", "2048",
            "--filter_th", "0.1",
            "--mutual",
            "--min_score", "0.0",
            "--use_ransac",
            "--ransac_thresh", "1.0",
            "--min_inliers", "50",
            "--deltas", "1,2,3,5",
            "--quality_config", "{quality_config}",
            "--auto_quality_refs",
            "--dump_quality_stats"
          ],
          "reuse_outputs": [
            "{scene_root}/tracks/track_build_quality_stats.json"
          ]
        },
        {
          "name": "rraa_input",
          "cmd": [
            "{python}",
            "tools/generate_rraa_input.py",
            "--dataset", "custom",
            "--Ks_npy", "{prepared_scene_dir}/Ks.npy",
            "--image_K_idx_npy", "{prepared_scene_dir}/image_K_idx.npy",
            "--image_list", "{prepared_scene_dir}/image_list.txt",
            "--out_npz", "{scene_root}/rraa_input/rraa_input_{scene_id}.npz",
            "--device", "auto",
            "--deltas", "1,2,3,5",
            "--max_kpts", "2048",
            "--filter_th", "0.1",
            "--ransac_px", "2.0",
            "--add_reverse",
            "--use_h_fallback",
            "--save_meta",
            "--save_names",
            "--quality_config", "{quality_config}",
            "--auto_quality_refs",
            "--dump_quality_stats"
          ],
          "reuse_outputs": [
            "{scene_root}/rraa_input/rraa_input_{scene_id}.npz"
          ]
        }
      ]
    }
  ]
}
